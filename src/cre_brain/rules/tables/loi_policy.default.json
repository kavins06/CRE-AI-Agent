      "content": {
        "hitPolicy": "first",
        "inputs": [
          {
            "id": "predicate",
            "name": "ExactPolicyPredicate",
            "field": "",
            "type": "expression"
          }
        ],
        "outputs": [
          {
            "id": "classification",
            "name": "classification",
            "field": "classification",
            "type": "expression"
