          }
        ],
        "rules": [
          {
            "_id": "missing_terms",
            "predicate": "price == null or dd_days == null or close_days == null or deposit_percent == null or financing_contingency == null",
            "classification": "\"review_required\"",
            "reason_code": "\"missing_terms\"",
            "required_checks": "[\"verify_loi_terms\"]"
          },
          {
            "_id": "price_exception",
            "predicate": "price > max_price",
            "classification": "\"approval_required\"",
            "reason_code": "\"price_exception\"",
            "required_checks": "[\"approve_loi_exception\"]"
          },
          {
            "_id": "dd_exception",
            "predicate": "dd_days < min_dd_days or dd_days > max_dd_days",
            "classification": "\"approval_required\"",
            "reason_code": "\"dd_exception\"",
            "required_checks": "[\"approve_loi_exception\"]"
          },
          {
            "_id": "closing_exception",
            "predicate": "close_days < min_close_days or close_days > max_close_days",
            "classification": "\"approval_required\"",
            "reason_code": "\"closing_exception\"",
            "required_checks": "[\"approve_loi_exception\"]"
          },
          {
            "_id": "deposit_exception",
            "predicate": "deposit_percent > max_deposit_percent",
            "classification": "\"approval_required\"",
            "reason_code": "\"deposit_exception\"",
            "required_checks": "[\"approve_loi_exception\"]"
          },
          {
            "_id": "contingency_exception",
            "predicate": "require_financing_contingency and not financing_contingency",
            "classification": "\"approval_required\"",
            "reason_code": "\"contingency_exception\"",
            "required_checks": "[\"approve_loi_exception\"]"
          },
          {
            "_id": "within_policy",
            "predicate": "",
            "classification": "\"within_policy\"",
            "reason_code": "\"within_policy\"",
            "required_checks": "[\"legal_review_before_use\"]"
          }
        ]
      }
    },
    {
